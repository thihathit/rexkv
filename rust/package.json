{
  "name": "rexkv-native",
  "version": "0.1.0",
  "private": true,
  "napi": {
    "binaryName": "rexkv",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "build": "napi build --platform --release --dts ../ts/types.d.ts",
    "build:debug": "napi build --platform --dts ../ts/types.d.ts"
  }
}
